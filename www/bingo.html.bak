        <div class="info-row">
            <div class="info-card info-card-game"><div class="info-label">🎯 Game</div><div class="info-value" id="games">-</div></div>
            <div class="info-card info-card-derash"><div class="info-label">💰 Derash</div><div class="info-value"><span id="cash-win">-</span><span style="font-size:0.5em;opacity:0.7;"> birr</span></div></div>
            <div class="info-card info-card-players"><div class="info-label">👥 Players</div><div class="info-value" id="player">-</div></div>
            <div class="info-card info-card-stake"><div class="info-label">💵 Stake</div><div class="info-value" id="stake">-</div></div>
            <div class="info-card info-card-calls"><div class="info-label">📞 Calls</div><div class="info-value" id="total-called">0</div></div>
        </div>

        <div class="game-area">
            <div class="bingo-board-panel glass rounded-xl p-1.5">
                <div id="bingoBoard" class="bingo-board"></div>
            </div>
            <div class="right-panel">
                <div class="recent-card glass rounded-xl">
                    <div class="recent-label">Recent Calls</div>
                    <div id="lastCalledNumbers" class="recent-balls">
                        <div class="recent-ball" style="opacity:0.2;background:rgba(100,116,139,0.3);">-</div>
                        <div class="recent-ball" style="opacity:0.2;background:rgba(100,116,139,0.3);">-</div>
                        <div class="recent-ball" style="opacity:0.2;background:rgba(100,116,139,0.3);">-</div>
                        <div class="recent-ball" style="opacity:0.2;background:rgba(100,116,139,0.3);">-</div>
                        <div class="recent-ball" style="opacity:0.2;background:rgba(100,116,139,0.3);">-</div>
                    </div>
                </div>
                <div class="sphere-card glass rounded-xl p-1" style="min-height:80px;">
                    <div id="sphere-container"><canvas id="renderCanvas"></canvas></div>
                    <div id="calledOverlay" class="called-overlay" style="display:none;"></div>
                </div>
            </div>
        </div>

        <div class="action-bar">
            <div class="glass rounded-xl" style="padding:0.35rem 0.5rem;">
                <div class="flex items-center gap-2 flex-wrap">
                    <button id="startBtn" class="btn-game btn-start">▶ Start</button>
                    <a href="./newgame.php" id="newGameLink" style="display:none;"><button class="btn-game btn-new">🆕 New Game</button></a>
                    <button id="finsh" class="btn-game btn-finish">✋ Finish</button>
                    <button id="shuffle" class="btn-game btn-shuffle">🔄 Shuffle</button>
                    <button id="claimBingoBtn" class="btn-game" style="background:linear-gradient(135deg,#7c3aed,#ec4899);color:#fff;">🎉 Claim Bingo</button>
                    <input id="check-input" class="game-input" type="text" placeholder="Check cartela" style="width:110px;text-align:left;">
                    <button id="check-btn" class="btn-game btn-check">🔍 Check</button>
                    <div class="flex items-center gap-1">
                        <span id="call-text" class="text-xs font-bold" style="color:rgba(100,116,139,0.6);white-space:nowrap;">Auto 4s</span>
                        <input type="range" id="call-speed" class="speed-slider" min="2" max="12" value="8">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="blur" class="cartela-modal">
        <div class="cartela-content">
            <div class="text-center mb-2">
                <div id="checkTitle" class="text-xl font-black">Cartela Check</div>
                <div id="checkStatus" class="mt-1"></div>
            </div>
            <div id="checkInfo" class="text-center font-bold text-sm mb-3"></div>
