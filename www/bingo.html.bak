        </nav></div>
        <div class="sidebar-footer"><div class="profile-card"><div class="profile-avatar">A</div><div><div style="font-size:0.75rem;font-weight:700;color:#e2e8f0;">Agent</div><div style="font-size:0.58rem;color:rgba(148,163,184,0.6);">Online</div></div><div style="width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px rgba(34,197,94,0.5);margin-left:auto;"></div></div></div>
    </aside>

    <div class="app-wrapper">
        <header class="flex-shrink-0 w-full flex items-center justify-between glass rounded-xl px-3 py-1">
            <div class="flex items-center gap-2">
                <button class="hamburger" id="menuBtn"><span></span><span></span><span></span></button>
                <h1 class="text-base sm:text-lg font-black tracking-tight whitespace-nowrap">
                    <span class="letter-u">U</span><span class="brand-text">nique </span><span class="letter-b">B</span><span class="brand-text">ingo</span>
                </h1>
                <span class="text-xs font-bold px-2 py-0.5 rounded-full" style="background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;box-shadow:0 2px 8px rgba(34,197,94,0.3);">LIVE</span>
            </div>
            <div class="flex items-center gap-2">
                <select id="lang" class="nav-select">
                    <option value="mnorb">M &amp; back</option><option value="fb">Fm &amp; back</option><option value="mfb">M-Repeat</option>
                    <option value="db">Duryew &amp; back</option><option value="f">Fm</option><option value="mf">M</option>
                    <option value="duu">Duryew</option><option value="mnor">M &amp; back</option>
                </select>
                <button id="fullscreen" class="nav-btn" title="Fullscreen">⛶</button>
