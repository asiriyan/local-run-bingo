
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Unique Bingo — Live Game</title>
    <link rel="stylesheet" href="../distcss/output.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; height: 100vh; overflow: hidden; font-family: 'Inter', system-ui, sans-serif; transition: background 0.4s, color 0.3s; }
        body { background: #d8dde5; color: #0f172a; }
        /* FIX: theme class is applied to <html>, not <body> — selector must reflect that
           so BOTH the background *and* the text/icon color actually flip in dark mode. */
        .dark body, html.dark body { background: #0b0f1a; color: #f1f5f9; }

        #bg-canvas-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; }

        .app-wrapper { position: relative; z-index: 10; height: 100vh; max-width: 1500px; margin: 0 auto; display: flex; flex-direction: column; padding: 0.3rem; overflow: hidden; gap: 0.3rem; }

        .glass { background: rgba(255,255,255,0.6); backdrop-filter: blur(16px) saturate(1.6); border: 1px solid rgba(255,255,255,0.35); box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
        .dark .glass { background: rgba(15,23,42,0.7); border-color: rgba(255,255,255,0.08); box-shadow: 0 8px 32px rgba(0,0,0,0.5); }

        .letter-u { color: #ef4444; text-shadow: 0 0 8px rgba(239,68,68,0.4); font-weight: 900; }
        .dark .letter-u { color: #f87171; text-shadow: 0 0 18px rgba(248,113,113,0.8); }
        .letter-b { color: #22c55e; text-shadow: 0 0 8px rgba(34,197,94,0.4); font-weight: 900; }
        .dark .letter-b { color: #4ade80; text-shadow: 0 0 18px rgba(74,222,128,0.8); }
        .brand-text { color: #1e293b; }
        .dark .brand-text { color: #e2e8f0; }

        /* Info Row */
        .info-row { flex-shrink: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.3rem; }
        .info-card { border-radius: 0.65rem; padding: 0.3rem 0.4rem 0.25rem; text-align: center; color: #fff; overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.22); position: relative; transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .info-card:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 10px 26px rgba(0,0,0,0.32); }
        .info-card::after { content:''; position:absolute; top:-60%; left:-60%; width:35%; height:220%; background: linear-gradient(120deg, transparent, rgba(255,255,255,0.3), transparent); transform: rotate(18deg); animation: cardShine 5.5s ease-in-out infinite; pointer-events: none; }
        .info-card-game { background: linear-gradient(135deg, #7c3aed, #5b21b6); }
        .info-card-derash { background: linear-gradient(135deg, #f59e0b, #b45309); }
        .info-card-players { background: linear-gradient(135deg, #10b981, #047857); }
        .info-card-stake { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
        .info-card-calls { background: linear-gradient(135deg, #ec4899, #be185d); }
        .info-card-calls::before { content:''; position:absolute; top:6px; right:8px; width:7px; height:7px; border-radius:50%; background:#fff; animation: livePulse 1.6s infinite; }
        .info-card .info-label { font-size: clamp(0.42rem, 0.9vw, 0.58rem); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.9; line-height: 1.1; }
        .info-card .info-value { font-size: clamp(0.75rem, 2vw, 1.2rem); font-weight: 900; line-height: 1.2; }
        .stat-pop { animation: statPop 0.4s ease; }
        @keyframes statPop { 0% { transform: scale(1); } 40% { transform: scale(1.28); } 100% { transform: scale(1); } }
        @keyframes cardShine { 0%, 85%, 100% { left: -60%; } 92% { left: 130%; } }
        @keyframes livePulse {
            0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.65); }
            70% { box-shadow: 0 0 0 7px rgba(255,255,255,0); }
            100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
        }
        /* ====== GAME AREA — RESPONSIVE, SAME STRUCTURE AT EVERY WIDTH ====== */
        .game-area { flex: 1; min-height: 0; display: flex; gap: 0.4rem; overflow: hidden; }

        /* ====== UNIFIED RIGHT PANEL + SPHERE — no structural switch, sizes scale via clamp ====== */
        .right-panel { width: clamp(140px, 36vw, 300px); flex-shrink: 0; flex-direction: column; }
        .recent-card { flex-shrink: 0; }
        .sphere-card { flex: 1; min-height: clamp(90px, 22vh, 220px); min-width: 0; }

        .recent-ball { width: clamp(24px, 6vw, 38px); height: clamp(24px, 6vw, 38px); font-size: clamp(0.5rem, 1.6vw, 0.8rem); }
        .called-overlay { font-size: clamp(0.75rem, 2.2vw, 1.4rem); padding: clamp(0.1rem, 0.5vw, 0.2rem) clamp(0.4rem, 1.5vw, 0.8rem); bottom: clamp(3px, 1vw, 8px); }

        /* ====== BINGO BOARD ====== */
        .bingo-board-panel { flex: 1; min-height: 0; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }

        /* Letter headers */
        .bingo-letter-header {
            text-align: center; font-weight: 900; border-radius: 0.35rem;
            flex-shrink: 0; line-height: 1;
        }
        .letter-b-bg { background: rgba(239,68,68,0.15); color: #ef4444; }
        .letter-i-bg { background: rgba(59,130,246,0.15); color: #3b82f6; }
        .letter-n-bg { background: rgba(34,197,94,0.15); color: #22c55e; }
        .letter-g-bg { background: rgba(234,179,8,0.15); color: #eab308; }
        .letter-o-bg { background: rgba(168,85,247,0.15); color: #a855f7; }
        .dark .letter-b-bg { background: rgba(239,68,68,0.1); color: #f87171; }
        .dark .letter-i-bg { background: rgba(59,130,246,0.1); color: #60a5fa; }
        .dark .letter-n-bg { background: rgba(34,197,94,0.1); color: #4ade80; }
        .dark .letter-g-bg { background: rgba(234,179,8,0.1); color: #facc15; }
        .dark .letter-o-bg { background: rgba(168,85,247,0.1); color: #c084fc; }

        /* ====== BOARD LAYOUT ======
           Small screens (<1100px): classic column-per-letter grid — B/I/N/G/O side by side,
           numbers stacked vertically inside each column. Cells use flex:1 so all 15 numbers
           in a column always fit the available height exactly — no internal scrolling, so the
           action bar at the bottom is always visible without scrolling the page.
           Large screens (>=1100px): letter-row layout — header on the left, numbers wrapping
           in a row to the right. */
        .bingo-board { flex: 1; min-height: 0; display: flex; overflow: hidden; }
        .bingo-col { display: flex; min-height: 0; min-width: 0; }
        .bingo-numbers-col { display: flex; min-height: 0; min-width: 0; }

        @media (max-width: 1099px) {
            /* Board takes a narrower, tighter share of the row; right panel shrinks to match
               instead of eating up to 36vw on phones — kills the dead space between columns. */
            .game-area { gap: 0.25rem; }
            .bingo-board-panel { flex: 1 1 45%; max-width: 45%;}
            .right-panel { flex: 1 1 55%; max-width: 55%; width: auto; }

            .bingo-board { flex-direction: row; align-items: stretch; gap: 1px; padding: 2px; }
            .bingo-col { flex: 1 1 0; flex-direction: column; align-items: stretch; gap: 1px; padding: 0 1px; }
            .bingo-letter-header { font-size: clamp(0.5rem, 2.4vw, 0.8rem); padding: 2px 0; }
            .bingo-numbers-col { flex: 1; flex-direction: column; justify-content: space-between; align-items: center; gap: 1px; overflow: hidden; }
            .bingo-cell { flex: 0 0 auto; width: min(100%, 24px); aspect-ratio: 1 / 1; border-radius: 50%; font-size: clamp(0.4rem, 1.6vh, 0.55rem); }
            
            .bingo-cell.called { font-size: clamp(0.48rem, 1.92vh, 0.66rem);background: radial-gradient(circle at 35% 30%, #86efac 0%, #22c55e 50%, #15803d 100%) !important;
            color: #fff !important;
            box-shadow: 0 0 14px rgba(34,197,94,0.4), inset -1px -1px 3px rgba(0,0,0,0.1) !important; }
            .recent-ball { width: clamp(18px, 5vw, 28px); height: clamp(18px, 5vw, 28px); font-size: clamp(0.42rem, 1.3vw, 0.65rem); }
        }
        @media (min-width: 1100px) {
            .bingo-board { flex-direction: column; gap: 0.3rem; overflow-y: auto; padding: 40px 10px 10px; }
            .bingo-col { flex-direction: row; align-items: center; gap: 0.4rem; flex: none; padding: 10px 0; }
            .bingo-letter-header { font-size: 1.4rem; padding: 0.3rem 0.5rem; width: 44px; flex-shrink: 0; }
            .bingo-numbers-col { flex-direction: row; flex-wrap: wrap; gap: 0.3rem; overflow-y: visible; flex: 1; align-items: center;padding-left: 20px; }
            .bingo-cell { flex: none; width: clamp(50px, 2.4vw, 44px); height: clamp(50px, 2.4vw, 44px); border-radius: 50%; font-size: clamp(1rem, 0.9vw, 1.5rem);margin:4px}
            .bingo-cell.called { font-size: clamp(1.2rem, 1.08vw, 1.8rem); background: radial-gradient(circle at 35% 30%, #86efac 0%, #22c55e 50%, #15803d 100%) !important;
            color: #fff !important;
            box-shadow: 0 0 14px rgba(34,197,94,0.4), inset -1px -1px 3px rgba(0,0,0,0.1) !important;}
        }

        /* ====== BALL CELLS — base look, size handled per breakpoint above ====== */
        .bingo-cell {
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; cursor: default;
            transition: background 0.3s, box-shadow 0.3s;
            user-select: none; position: relative; flex-shrink: 0;
            background: radial-gradient(circle at 35% 30%, #ffffff 0%, #e2e8f0 40%, #94a3b8 100%);
            color: #475569;
            box-shadow: inset -1px -2px 3px rgba(0,0,0,0.12), 1px 2px 5px rgba(0,0,0,0.08);
            }

            .dark .bingo-cell {
            background: radial-gradient(circle at 35% 30%, #64748b 0%, #334155 50%, #1e293b 100%);
            color: #cbd5e1;
            box-shadow: inset -1px -2px 3px rgba(0,0,0,0.25), 1px 2px 5px rgba(0,0,0,0.15);
            }

            .bingo-cell.blink {
                animation: blink-animation 1s infinite, bounce 1s infinite, size-transform 1s infinite;
                background: #fff521;
                color: #000000;
                border-color: #ffaf00;
                opacity: 1;
            }


        /* ====== CALLED: GREEN BALL ====== */
        /* ====== CALLED: GREEN BALL ====== */


         
            
        .dark .bingo-cell.called {
            background: radial-gradient(circle at 35% 30%, #4ade80 0%, #16a34a 50%, #166534 100%) !important;
        }

        /* ====== JUST-CALLED: blink / bounce / size-pulse (as supplied) ====== */
        .bingo-cell.just-called {
            z-index: 5;
        }
        
        .blink-result {
            animation: blink-animation 1s infinite, bounce 1s infinite, size-transform 1s infinite;
            opacity: 1;
        }
        @keyframes blink-animation {
            50% {
                background-color: #ffaf00; /* Change background color for blinking effect */
            }
        }
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }
            40% {
                transform: translateY(-30px);
            }
            60% {
                transform: translateY(-15px);
            }
        }
        @keyframes size-transform {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.4); /* Increase size to 120% */
            }
        }

        /* Right Panel */
        .right-panel { display: flex; gap: 0.3rem; overflow: hidden; }

        /* Recent Calls */
        .recent-card { flex-shrink: 0; padding: 0.4rem; }
        .recent-label { font-size: 0.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(100,116,139,0.7); margin-bottom: 0.2rem; text-align: center; }
        .dark .recent-label { color: rgba(148,163,184,0.5); }
        .recent-balls { display: flex; gap: 0.3rem; justify-content: center; flex-wrap: wrap; }
        .recent-ball {
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: #fff; box-shadow: 0 3px 10px rgba(0,0,0,0.2);
            transition: all 0.3s; flex-shrink: 0;
        }
        .recent-ball:first-child { transform: scale(1.15); box-shadow: 0 4px 14px rgba(0,0,0,0.3); }

        /* Sphere */
        .sphere-card { display: flex; flex-direction: column; overflow: hidden; position: relative; }
        #sphere-container { flex: 1; min-height: 0; min-width: 0; position: relative; }
        #sphere-container canvas { display: block; width: 100% !important; height: 100% !important; }
        .called-overlay {
            position: absolute; left: 50%; transform: translateX(-50%);
            font-weight: 900; color: #fff; pointer-events: none; z-index: 2;
            background: linear-gradient(135deg, rgba(234,179,8,0.92), rgba(202,138,4,0.92));
            border-radius: 1rem; box-shadow: 0 4px 20px rgba(234,179,8,0.5);
            animation: bounceCall 0.7s cubic-bezier(0.34,1.56,0.64,1);
        }

        /* Action Bar */
        .action-bar { flex-shrink: 0; }
        .btn-game { font-weight: 700; padding: 0.35rem 0.7rem; border-radius: 0.5rem; border: none; cursor: pointer; transition: all 0.2s; font-size: clamp(0.55rem, 1vw, 0.7rem); position: relative; overflow: hidden; }
        .btn-game::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent); transform: translateX(-120%); transition: transform 0.5s ease; }
        .btn-game:hover::after { transform: translateX(120%); }
        .btn-game:hover { transform: translateY(-2px) scale(1.04); filter: brightness(1.1); box-shadow: 0 6px 16px rgba(0,0,0,0.25); }
        .btn-game:active { transform: scale(0.94); }
        .btn-start { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; box-shadow: 0 3px 12px rgba(34,197,94,0.3); }
        .btn-pause { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; box-shadow: 0 3px 12px rgba(245,158,11,0.3); }
        .btn-new { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; box-shadow: 0 3px 12px rgba(239,68,68,0.3); }
        .btn-finish { background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }
        .btn-shuffle { background: rgba(59,130,246,0.15); color: #3b82f6; border: 1px solid rgba(59,130,246,0.3); }
        .btn-check { background: rgba(168,85,247,0.15); color: #a855f7; border: 1px solid rgba(168,85,247,0.3); }
        .dark .btn-finish { background: rgba(239,68,68,0.1); color: #f87171; border-color: rgba(239,68,68,0.2); }
        .dark .btn-shuffle { background: rgba(59,130,246,0.1); color: #60a5fa; border-color: rgba(59,130,246,0.2); }
        .dark .btn-check { background: rgba(168,85,247,0.1); color: #c084fc; border-color: rgba(168,85,247,0.2); }
        .game-input { background: rgba(255,255,255,0.5); border: 1px solid rgba(0,0,0,0.1); border-radius: 0.4rem; padding: 0.25rem 0.4rem; font-weight: 700; font-size: clamp(0.55rem, 1vw, 0.7rem); color: #0f172a; outline: none; width: 55px; text-align: center; }
        .dark .game-input { background: rgba(30,41,59,0.5); color: #f1f5f9; border-color: rgba(255,255,255,0.1); }
        .game-input:focus { border-color: #7c3aed; box-shadow: 0 0 0 2px rgba(124,58,237,0.2); }

        .nav-select { background: rgba(255,255,255,0.5); border: 1px solid rgba(0,0,0,0.1); border-radius: 0.3rem; padding: 0.15rem; font-weight: 700; font-size: 0.6rem; color: #0f172a; outline: none; cursor: pointer; transition: all 0.2s; }
        .dark .nav-select { background: rgba(30,41,59,0.5); color: #f1f5f9; border-color: rgba(255,255,255,0.1); }
        .nav-select:hover { border-color: #7c3aed; }
        /* FIX: relied on color:inherit from body — now that body actually receives .dark styles
           (see .dark body above) these icons inherit #f1f5f9 correctly in dark mode. */
        .nav-btn { background: none; border: none; cursor: pointer; color: inherit; font-size: 0.85rem; opacity: 0.85; transition: all 0.2s; border-radius: 0.4rem; padding: 0.2rem 0.35rem; }
        .nav-btn:hover { opacity: 1; background: rgba(124,58,237,0.14); transform: scale(1.12); }
        .dark .nav-btn { color: #f1f5f9; }
        .hamburger { color: inherit; }
        .dark .hamburger { color: #f1f5f9; }
        .theme-toggle { background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.15); border-radius: 9999px; padding: 0.15rem 0.4rem; display: flex; align-items: center; gap: 0.25rem; cursor: pointer; transition: all 0.3s; color: #0f172a; font-size: 0.7rem; font-weight: 600; }
        .theme-toggle:hover { transform: scale(1.08); box-shadow: 0 4px 14px rgba(124,58,237,0.3); }
        .dark .theme-toggle { color: #f1f5f9; background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.06); }
        .dark .theme-toggle .icon-sun { display: none; }
        .theme-toggle .icon-moon { display: none; }
        .dark .theme-toggle .icon-moon { display: block; }
        .speed-slider { -webkit-appearance: none; appearance: none; height: 3px; border-radius: 2px; background: rgba(124,58,237,0.2); outline: none; width: 60px; cursor: pointer; }
        .speed-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg, #7c3aed, #ec4899); cursor: pointer; }

        .hamburger { display: flex; flex-direction: column; gap: 4px; background: none; border: none; padding: 0.25rem; cursor: pointer; border-radius: 0.4rem; transition: background 0.2s; }
        .hamburger:hover { background: rgba(124,58,237,0.14); }
        .hamburger span { display: block; width: 20px; height: 2.5px; border-radius: 999px; background: currentColor; transition: transform 0.25s; }
        .hamburger:hover span:nth-child(1) { transform: translateX(2px); }
        .hamburger:hover span:nth-child(3) { transform: translateX(-2px); }

        /* Sidebar */
        .sidebar { position: fixed; top: 0; left: 0; height: 100vh; width: 290px; background: linear-gradient(180deg, rgba(15,23,42,0.96), rgba(30,20,60,0.97) 50%, rgba(15,23,42,0.96)); backdrop-filter: blur(24px); border-right: 1px solid rgba(124,58,237,0.15); transform: translateX(-100%); transition: transform 0.4s cubic-bezier(0.22,1,0.36,1); z-index: 1000; padding: 0; color: #f1f5f9; display: flex; flex-direction: column; overflow: hidden; }
        .sidebar.open { transform: translateX(0); }
        .sidebar::before { content: ''; position: absolute; top: -40%; left: -30%; width: 160%; height: 60%; background: radial-gradient(ellipse, rgba(124,58,237,0.08) 0%, transparent 70%); pointer-events: none; }
        .sidebar .close-btn { position: absolute; top: 1rem; right: 1rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); color: #94a3b8; width: 2rem; height: 2rem; border-radius: 0.5rem; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 2; transition: all 0.2s; }
        .sidebar .close-btn:hover { background: rgba(239,68,68,0.2); color: #f87171; transform: rotate(90deg); }
        .sidebar-header { position: relative; z-index: 1; padding: 1.5rem 1.25rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
        .sidebar-header .brand-row { display: flex; align-items: center; gap: 0.6rem; }
        .sidebar-header .brand-icon { width: 2.5rem; height: 2.5rem; border-radius: 0.7rem; background: linear-gradient(135deg, #7c3aed, #ec4899); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; box-shadow: 0 4px 16px rgba(124,58,237,0.4); animation: float 4s ease-in-out infinite; }
        .sidebar-header .brand-name { font-size: 1.35rem; font-weight: 900; }
        .sidebar-header .brand-sub { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(148,163,184,0.6); font-weight: 600; }
        .sidebar-nav { position: relative; z-index: 1; flex: 1; padding: 0.75rem; overflow-y: auto; }
        .nav-section-label { font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(148,163,184,0.4); font-weight: 700; padding: 0.6rem 0.75rem 0.35rem; }
        .sidebar nav ul { list-style: none; }
        .sidebar nav ul li a { display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 0.75rem; border-radius: 0.65rem; color: rgba(203,213,225,0.85); transition: all 0.25s; font-weight: 600; font-size: 0.85rem; text-decoration: none; }
        .sidebar nav ul li a:hover { color: #fff; background: rgba(124,58,237,0.12); transform: translateX(3px); }
        .nav-icon-box { width: 1.75rem; height: 1.75rem; border-radius: 0.45rem; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; flex-shrink: 0; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); }
        .sidebar nav ul li a.active { color: #fff; background: linear-gradient(135deg, rgba(124,58,237,0.25), rgba(236,72,153,0.15)); }
        .sidebar nav ul li a.active .nav-icon-box { background: linear-gradient(135deg, #7c3aed, #ec4899); box-shadow: 0 3px 12px rgba(124,58,237,0.4); border: none; }
        .sidebar-footer { position: relative; z-index: 1; padding: 0.75rem; border-top: 1px solid rgba(255,255,255,0.06); }
        .sidebar-footer .profile-card { display: flex; align-items: center; gap: 0.65rem; padding: 0.6rem; border-radius: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); }
        .profile-avatar { width: 2rem; height: 2rem; border-radius: 50%; background: linear-gradient(135deg, #7c3aed, #ec4899); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.75rem; color: #fff; }
        .sidebar-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(6px); z-index: 999; opacity: 0; pointer-events: none; transition: opacity 0.4s; }
        .sidebar-overlay.active { opacity: 1; pointer-events: all; }

        /* Cartela Modal */
        .cartela-modal { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,0.6); backdrop-filter: blur(10px); display: none; align-items: center; justify-content: center; }
        .cartela-modal.active { display: flex; }
        .cartela-content { background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); border-radius: 1.2rem; padding: 1.5rem; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 420px; width: 90%; }
        .dark .cartela-content { background: rgba(15,23,42,0.95); }
        .cartela-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.35rem; margin: 0.8rem 0; }
        .cartela-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 700; font-size: clamp(0.65rem, 1.5vw, 0.9rem); background: rgba(226,232,240,0.7); color: rgba(15,23,42,0.7); }
        .dark .cartela-cell { background: rgba(30,41,59,0.6); color: rgba(241,245,249,0.7); }
        .cartela-cell.called-cell { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
        .cartela-cell.star-cell { background: rgba(168,85,247,0.2) !important; color: #a855f7 !important; }
        .cartela-cell.miss-cell { background: rgba(239,68,68,0.15) !important; color: #ef4444 !important; }

        /* FIX: these were hardcoded to a light-mode-only color and vanished on dark background */
        #checkTitle { color: #0f172a; font-weight: 900; }
        .dark #checkTitle { color: #f8fafc; }
        #checkInfo { color: rgba(100,116,139,0.85); }
        .dark #checkInfo { color: rgba(203,213,225,0.85); }
        #close { background: rgba(0,0,0,0.08); color: #0f172a; }
        .dark #close { background: rgba(255,255,255,0.08); color: #f1f5f9; }

        /* ====== MODERNIZED STATUS BADGE (bold / glowing / animated) ====== */
        .status-badge {
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.5rem 1.15rem; border-radius: 999px;
            font-weight: 900; font-size: 1rem; letter-spacing: 0.01em;
            box-shadow: 0 6px 20px rgba(0,0,0,0.28);
            animation: badgePop 0.45s cubic-bezier(0.34,1.56,0.64,1);
        }
        .status-badge .badge-icon { font-size: 1.15em; line-height: 1; }
        @keyframes badgePop { 0% { transform: scale(0.3); opacity: 0; } 60% { transform: scale(1.18); } 100% { transform: scale(1); opacity: 1; } }
        @keyframes badgeGlow {
            0%, 100% { box-shadow: 0 6px 20px var(--glow-c1, rgba(34,197,94,0.45)); }
            50% { box-shadow: 0 8px 32px var(--glow-c2, rgba(34,197,94,0.85)); }
        }
        .status-bingo { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; --glow-c1: rgba(34,197,94,0.45); --glow-c2: rgba(34,197,94,0.9); animation: badgePop 0.45s cubic-bezier(0.34,1.56,0.64,1), badgeGlow 1.5s ease-in-out infinite; }
        .status-ongoing { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
        .status-out { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
        .status-free { background: linear-gradient(135deg, #7c3aed, #ec4899); color: #fff; --glow-c1: rgba(124,58,237,0.45); --glow-c2: rgba(236,72,153,0.9); animation: badgePop 0.45s cubic-bezier(0.34,1.56,0.64,1), badgeGlow 1.5s ease-in-out infinite; }
        .status-bonus { background: linear-gradient(135deg, #eab308, #ca8a04); color: #1c1503; --glow-c1: rgba(234,179,8,0.5); --glow-c2: rgba(234,179,8,0.95); animation: badgePop 0.45s cubic-bezier(0.34,1.56,0.64,1), badgeGlow 1.3s ease-in-out infinite; }

        /* Bonus toast (happy hour / combo bonuses) */
        #bonusToastHost { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 2000; display: flex; flex-direction: column; gap: 0.4rem; pointer-events: none; }
        .bonus-toast {
            font-weight: 900; font-size: 0.85rem; color: #fff; padding: 0.55rem 1.1rem;
            border-radius: 0.75rem; background: linear-gradient(135deg, #eab308, #ca8a04);
            box-shadow: 0 8px 24px rgba(234,179,8,0.5);
            animation: toastIn 0.4s cubic-bezier(0.34,1.56,0.64,1), toastOut 0.4s ease forwards 2.6s;
        }
        @keyframes toastIn { 0% { transform: translateY(-30px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
        @keyframes toastOut { 0% { opacity: 1; } 100% { opacity: 0; transform: translateY(-15px); } }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #7c3aed66; border-radius: 999px; }

        /* ================================================================
           CLASSIC CARTELA-CHECK UI — restores the look/feel of the old
           source.js cartela grid (bg-gray-300 → bg-[#db98e9] → green/yellow)
           on top of the new #cartelaGrid .a{row}{col} markup.
           ================================================================ */
        #cartelaGrid .cartela-cell { background: #d1d5db !important; color: rgba(0,0,0,0.7) !important; font-weight: 700; box-shadow: none !important; }
        #cartelaGrid .cartela-cell.called-cell { background: #db98e9 !important; color: rgba(0,0,0,0.9) !important; }
        #cartelaGrid .cartela-cell.star-cell { background: #db98e9 !important; color: rgba(0,0,0,0.9) !important; }
        #cartelaGrid .cartela-cell.cc-win-blink { background: #22c55e !important; color: #000 !important; animation: ccWinPulse 0.9s ease-in-out infinite; }
        #cartelaGrid .cartela-cell.cc-win { background: #22c55e !important; color: #000 !important; }
        @keyframes ccWinPulse { 0%, 100% { transform: scale(1); filter: brightness(1); } 50% { transform: scale(1.2); filter: brightness(1.3); } }
        #cartelaGrid .cartela-cell.cc-missed { background: #eab308 !important; color: #000 !important; }

        .status-bingo  { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; --glow-c1: rgba(34,197,94,.45);  --glow-c2: rgba(34,197,94,.9); }
        .status-missed { background: linear-gradient(135deg, #eab308, #a16207); color: #1c1503; --glow-c1: rgba(234,179,8,.45); --glow-c2: rgba(234,179,8,.9); animation: badgePop 0.45s cubic-bezier(0.34,1.56,0.64,1), badgeGlow 1.5s ease-in-out infinite; }
        .status-out    { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }

        /* Happy Hour Space Popup */
        .happy-hour-modal {
            position: fixed; inset: 0; z-index: 100;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            display: none; align-items: center; justify-content: center;
        }
        .happy-hour-modal.active { display: flex; }
        .happy-hour-content {
            position: relative;
            background: linear-gradient(135deg, rgba(30, 27, 75, 0.95), rgba(59, 30, 96, 0.95));
            border-radius: 1.5rem;
            padding: 2.5rem 2rem;
            box-shadow: 0 25px 80px rgba(124, 58, 237, 0.5), 0 0 60px rgba(236, 72, 153, 0.3);
            max-width: 380px; width: 85%;
            text-align: center;
            border: 2px solid rgba(168, 85, 247, 0.4);
        }
        .dark .happy-hour-content {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 27, 75, 0.95));
            border: 2px solid rgba(168, 85, 247, 0.3);
        }
        .stars-container {
            position: absolute; inset: 0; overflow: hidden; border-radius: 1.3rem; pointer-events: none;
        }
        .star {
            position: absolute; width: 4px; height: 4px;
            background: #fff; border-radius: 50%;
            animation: twinkle 2s ease-in-out infinite;
        }
        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.5); }
        }
        .happy-hour-icon {
            font-size: 4rem; margin-bottom: 1rem;
            animation: rocketFloat 3s ease-in-out infinite;
        }
        @keyframes rocketFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-10px) scale(1.1); }
        }
        .happy-hour-title {
            font-size: 1.75rem; font-weight: 900;
            background: linear-gradient(135deg, #fbbf24, #f59e0b, #fbbf24);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text; background-size: 200% 200%;
            animation: shine 3s ease-in-out infinite;
            margin-bottom: 0.5rem;
        }
        @keyframes shine {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        .happy-hour-amount {
            font-size: 2.5rem; font-weight: 900;
            color: #22c55e;
            text-shadow: 0 0 30px rgba(34, 197, 94, 0.8);
            margin-bottom: 0.5rem;
        }
        .happy-hour-subtitle {
            font-size: 0.9rem; color: rgba(234, 179, 8, 0.8);
            text-transform: uppercase; letter-spacing: 0.15em;
        }
        /* Firework effect overlay */
        .happy-hour-modal.active::after {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.3), transparent 70%);
            animation: pulseGlow 1.5s ease-in-out infinite;
        }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }
    </style>
</head>
<body class='p-1 md:p-0'>
